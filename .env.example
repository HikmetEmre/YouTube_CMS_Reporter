# Copy to .env and fill in. Never commit .env.

# REQUIRED. Every file password and the history store derive from this key.
# Generate one with:  docker compose run --rm cli keygen
# Lose it and existing encrypted files cannot be opened; change it and every password changes.
CMS_MASTER_KEY=

# --- Channel backup (YouTube Data API v3, public data) ---
YOUTUBE_API_KEY=

# --- Audience analytics in reports (YouTube Analytics API, OAuth) ---
# Path inside the container, e.g. /app/config/client_secret.json
YT_CLIENT_SECRET_FILE=
YT_CONTENT_OWNER_ID=

# --- E-mail: client delivery and e-mail alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Conflict alerts: configure any of these; with none, alerts print to the log ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: shown as a link on the Alerts page so people can find the bot
TELEGRAM_BOT_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# optional: the Twilio sandbox phrase people send first, e.g. "join silver-fox"
TWILIO_SANDBOX_JOIN=
# comma-separated, international format: +905550000000,+905550000001
WHATSAPP_TO=
ALERT_EMAIL_TO=

# --- Conflict source: YouTube notification mailbox (optional) ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SENDER=youtube.com

# --- Public demo instance only ---
# 1 = every visitor gets a private, temporary copy of a synthetic workspace;
# nothing is e-mailed or sent to chat. Leave empty when running it for real.
CMS_DEMO_MODE=
